{
  "A": {"class_type": "LoadImage", "inputs": {"image": "__A__"}},
  "crop": {
    "class_type": "ImageCrop",
    "inputs": {"image": ["A", 0], "width": 720, "height": 1536, "x": 2, "y": 0}
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {"images": ["crop", 0], "filename_prefix": "__OUTPUT__"}
  }
}
